      "onChange": {
        "enabled": null,
        "script": "\tval \u003d (currentValue.value or \"\").strip()\n\tif not val:\n\t\treturn\n\t\n\tform \u003d self.view.custom\n\tmsg \u003d form.message or \"\"\n\ttid \u003d form.toastId or \"op\"\n\t\n\ttry:\n\t\tif val \u003d\u003d \"success\":\n\t\t\ttoast.success(msg)\n\t\telif val \u003d\u003d \"info\":\n\t\t\ttoast.info(msg)\n\t\telif val \u003d\u003d \"warn\":\n\t\t\ttoast.warn(msg)\n\t\telif val \u003d\u003d \"error\":\n\t\t\ttoast.error(msg)\n\t\telif val \u003d\u003d \"loading\":\n\t\t\ttoast.loading(msg or \"Working...\", tid)\n\t\telif val \u003d\u003d \"update\":\n\t\t\t# change type if needed: \"success\" | \"error\" | \"info\" | \"warning\" | \"default\"\n\t\t\ttoast.update(tid, msg or \"Done\", \"success\")\n\t\telif val \u003d\u003d \"dismiss\":\n\t\t\tif (form.toastId or \"\").strip():\n\t\t\t\ttoast.dismiss(tid)\n\t\t\telse:\n\t\t\t\ttoast.dismiss()\n\tfinally:\n\t\t# reset trigger so it won\u0027t retrigger\n\t\tself.view.custom.trigger \u003d \"\""
      },
      "persistent": true
    }
  },
