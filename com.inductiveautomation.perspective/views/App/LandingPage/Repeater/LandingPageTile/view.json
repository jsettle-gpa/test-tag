{
  "custom": {},
  "params": {
    "imageSource": "",
    "navToPath": "/",
    "title": "Home"
  },
  "propConfig": {
    "params.imageSource": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.navToPath": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.title": {
      "paramDirection": "input",
      "persistent": true
    }
  },
  "props": {
    "defaultSize": {
      "height": 217,
      "width": 399
    }
  },
  "root": {
    "children": [
      {
        "meta": {
          "name": "Title"
        },
        "position": {
          "basis": "32px"
        },
        "propConfig": {
          "props.text": {
            "binding": {
              "config": {
                "path": "view.params.title"
              },
              "type": "property"
            }
          }
        },
        "props": {
          "style": {
            "classes": "card-title"
          },
          "textStyle": {
            "classes": "card-title",
            "textAlign": "center"
          }
        },
        "type": "ia.display.label"
      },
      {
        "meta": {
          "name": "Image"
        },
        "position": {
          "basis": "138px"
        },
        "props": {
          "fit": {
            "height": 75,
            "mode": "contain",
            "width": 75
          },
          "source": "/system/images/6.png"
        },
        "type": "ia.display.image"
      }
    ],
    "events": {
      "dom": {
        "onClick": {
          "config": {
            "page": "{view.params.navToPath}"
          },
          "scope": "C",
          "type": "nav"
        }
      }
    },
    "meta": {
      "name": "root",
      "tooltip": {
        "enabled": true
      }
    },
    "propConfig": {
      "meta.tooltip.text": {
        "binding": {
          "config": {
            "expression": "\u0027Press to navigate to the \u0027 + {view.params.title} + \u0027 page\u0027"
          },
          "type": "expr"
        }
      }
    },
    "props": {
      "direction": "column",
      "style": {
        "classes": "selectable-card card-title",
        "overflow": "visible"
      }
    },
    "type": "ia.container.flex"
  }
}