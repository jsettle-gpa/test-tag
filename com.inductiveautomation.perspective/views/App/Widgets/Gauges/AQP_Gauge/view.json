{
  "custom": {
    "A": 0,
    "OEE": 0,
    "P": 0,
    "Q": 0
  },
  "params": {
    "BadThreshold": 60,
    "EqPath": "",
    "ErrorColor": "#E53935",
    "FontSize": 18,
    "GoodColor": "#4AA3FF",
    "Thickness": 14,
    "WarnColor": "#FFC107",
    "WarnThreshold": 75
  },
  "propConfig": {
    "custom.A": {
      "binding": {
        "config": {
          "fallbackDelay": 0.25,
          "mode": "indirect",
          "references": {
            "EqPath": "{view.params.EqPath}"
          },
          "tagPath": "{EqPath}/calculatedValues/availability"
        },
        "transforms": [
          {
            "expression": "toInt(coalesce({value},0)*100)",
            "type": "expression"
          }
        ],
        "type": "tag"
      },
      "persistent": true
    },
    "custom.OEE": {
      "binding": {
        "config": {
          "fallbackDelay": 0.25,
          "mode": "indirect",
