          "fallbackDelay": 0.25,
          "mode": "indirect",
          "references": {
            "EqPath": "{view.params.EqPath}"
          },
          "tagPath": "{EqPath}/calculatedValues/quality"
        },
        "transforms": [
          {
            "expression": "toInt(coalesce({value},0)*100)",
            "type": "expression"
          }
        ],
        "type": "tag"
      },
      "persistent": true
    },
    "params.BadThreshold": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.EqPath": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.ErrorColor": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.FontSize": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.GoodColor": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.Thickness": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.WarnColor": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.WarnThreshold": {
      "paramDirection": "input",
      "persistent": true
    }
  },
  "props": {
    "defaultSize": {
      "height": 205,
      "width": 778
    }
  },
  "root": {
    "children": [
      {
        "children": [
          {
            "meta": {
              "name": "OEE_Gauge"
            },
            "position": {
              "grow": 1
            },
            "propConfig": {
              "props.arc.color": {
                "binding": {
                  "config": {
                    "expression": "if({view.custom.OEE} \u003c {view.params.BadThreshold}, {view.params.ErrorColor}, if({view.custom.OEE} \u003c {view.params.WarnThreshold}, {view.params.WarnColor}, {view.params.GoodColor}))"
                  },
                  "type": "expr"
                }
              },
              "props.arc.width": {
                "binding": {
                  "config": {
                    "path": "view.params.Thickness"
                  },
                  "type": "property"
                }
              },
              "props.arcBackground.color": {
                "binding": {
                  "config": {
                    "expression": "if({view.custom.OEE} \u003c {view.params.BadThreshold}, {view.params.ErrorColor}, if({view.custom.OEE} \u003c {view.params.WarnThreshold}, {view.params.WarnColor}, {view.params.GoodColor}))"
                  },
                  "type": "expr"
                }
              },
              "props.label.offsetY": {
                "binding": {
                  "config": {
                    "expression": "toInt({this.props.label.size}*0.9)"
                  },
                  "type": "expr"
                }
              },
              "props.label.size": {
                "binding": {
                  "config": {
                    "path": "view.params.FontSize"
                  },
                  "type": "property"
                }
              },
              "props.value": {
                "binding": {
                  "config": {
                    "path": "view.custom.OEE"
                  },
                  "type": "property"
                }
              }
            },
            "props": {
              "animate": true,
              "arc": {},
              "arcBackground": {},
              "endAngle": 630,
              "label": {
                "units": "%"
              },
              "startAngle": 270,
              "style": {
                "width": "100%"
              }
            },
            "type": "ia.chart.simple-gauge"
          },
          {
            "meta": {
              "name": "OEE_Label"
            },
            "position": {
              "grow": 1
            },
