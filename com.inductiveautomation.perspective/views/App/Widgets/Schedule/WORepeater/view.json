  "propConfig": {
    "custom.FilterWorkOrders": {
      "binding": {
        "config": {
          "path": "view.custom.search"
        },
        "transforms": [
          {
            "code": "\t# transform(self, value, quality, timestamp)\n\t# value \u003d current search text\n\t\n\tq \u003d (value or \u0027\u0027).strip()\n\t\n\t# Source list (change to self.view.custom.workorders if that\u0027s your source)\n\trecords \u003d self.view.params.workorders or []\n\tif not records:\n\t\treturn []\n\t\n\tdef digits_only(x):\n\t\treturn \u0027\u0027.join([ch for ch in str(x or \u0027\u0027) if ch.isdigit()])\n\t\n\tdef get(rec, key, default\u003dNone):\n\t\ttry:\n\t\t\treturn (rec.get(\u0027data\u0027) or {}).get(key, default)\n\t\texcept:\n\t\t\treturn default\n\t\n\tdef prio(rec):\n\t\ttry:\n\t\t\treturn int(get(rec, \u0027Priority\u0027, 0))\n\t\texcept:\n\t\t\treturn 0\n\t\n\tdef start_ts(rec):\n\t\ttry:\n\t\t\treturn int(get(rec, \u0027StartTs\u0027, 0))\n\t\texcept:\n\t\t\treturn 0\n\t\n\tdef lot_digits(rec):\n\t\treturn digits_only(get(rec, \u0027LotNumber\u0027, \u0027\u0027))\n\t\n\tq_dig \u003d digits_only(q)\n\t\n\tif q_dig:\n\t\t# rank: 0 \u003d startswith, 1 \u003d contains, 2 \u003d no match\n\t\tdef key(rec):\n\t\t\tlot \u003d lot_digits(rec)\n\t\t\tif lot.startswith(q_dig):\n\t\t\t\trank \u003d 0\n\t\t\telif q_dig in lot:\n\t\t\t\trank \u003d 1\n\t\t\telse:\n\t\t\t\trank \u003d 2\n\t\t\treturn (rank, -prio(rec), start_ts(rec), lot)\n\telse:\n\t\t# default ordering when there is no search\n\t\tdef key(rec):\n\t\t\treturn (-prio(rec), start_ts(rec), lot_digits(rec))\n\t\n\t# Return the whole list, just reordered\n\treturn sorted(records, key\u003dkey)",
            "type": "script"
          }
        ],
        "type": "property"
      },
      "persistent": true
    },
    "custom.search": {
      "binding": {
        "config": {
          "path": "/root/SearchRow/Search.props.text"
        },
        "type": "property"
      },
      "persistent": false
    },
    "params.workorders": {
      "paramDirection": "input",
      "persistent": true
    }
