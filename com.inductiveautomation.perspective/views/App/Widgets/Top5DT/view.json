                "path": "view.params.Top5Data"
              },
              "type": "property"
            }
          }
        },
        "props": {
          "columns": [
            {
              "field": "Reason",
              "header": {
                "title": "Reason"
              },
              "width": "flex"
            },
            {
              "field": "Minutes",
              "header": {
                "title": "Min"
              },
              "number": "value",
              "numberFormat": "0,0",
              "width": "120px"
            }
          ]
        },
        "type": "ia.display.table"
      }
    ],
    "meta": {
      "name": "root"
