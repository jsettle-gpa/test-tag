    "meta": {
      "name": "root"
    },
    "props": {
      "direction": "column",
      "style": {
        "border": "1px solid var(--neutral-40)",
        "borderRadius": "10px",
        "classes": "card",
        "gap": "8px",
        "padding": "12px"
      }
    },
    "type": "ia.container.flex"
  }
