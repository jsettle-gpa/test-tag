{
  "custom": {},
  "params": {
    "Color": "#2E7D32",
    "LineName": "Line 1",
    "Mode": "Auto",
    "Status": "Running"
  },
  "propConfig": {
    "params.Color": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.LineName": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.Mode": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.Status": {
      "paramDirection": "input",
      "persistent": true
    }
  },
  "props": {
    "defaultSize": {
      "height": 200,
      "width": 380
    }
  },
  "root": {
    "children": [
      {
        "children": [
          {
            "meta": {
              "name": "Icon"
            },
            "props": {
              "path": "material/factory",
              "style": {
                "fontSize": 22
              }
            },
            "type": "ia.display.icon"
          },
          {
            "meta": {
              "name": "Title"
            },
            "propConfig": {
              "props.text": {
                "binding": {
                  "config": {
                    "path": "view.params.LineName"
                  },
                  "type": "property"
                }
              }
            },
            "props": {
              "style": {
                "fontWeight": "600"
              }
            },
            "type": "ia.display.label"
          }
        ],
        "meta": {
          "name": "Header"
        },
        "props": {
          "alignItems": "center",
          "style": {
            "gap": "8px"
          }
        },
        "type": "ia.container.flex"
      },
      {
        "children": [
          {
            "children": [
              {
                "meta": {
                  "name": "Lbl1"
                },
                "props": {
                  "style": {
                    "fontSize": "12px",
                    "opacity": 0.7
                  },
                  "text": "Status"
                },
                "type": "ia.display.label"
              },
              {
                "meta": {
                  "name": "Val1"
                },
                "propConfig": {
                  "props.style.color": {
                    "binding": {
                      "config": {
                        "path": "view.params.Color"
                      },
                      "type": "property"
                    }
                  },
                  "props.text": {
                    "binding": {
                      "config": {
                        "path": "view.params.Status"
                      },
                      "type": "property"
                    }
                  }
                },
                "props": {
                  "style": {
                    "fontSize": "18px",
                    "fontWeight": "600"
                  }
                },
                "type": "ia.display.label"
              },
              {
                "meta": {
                  "name": "Lbl2"
                },
                "props": {
                  "style": {
                    "fontSize": "12px",
                    "opacity": 0.7
                  },
                  "text": "Mode"
                },
                "type": "ia.display.label"
              },
              {
                "meta": {
                  "name": "Val2"
                },
                "propConfig": {
                  "props.text": {
                    "binding": {
                      "config": {
                        "path": "view.params.Mode"
                      },
                      "type": "property"
                    }
                  }
                },
                "type": "ia.display.label"
              }
            ],
            "meta": {
              "name": "StatusBlock"
            },
            "position": {
              "basis": "112px"
            },
            "props": {
              "direction": "column",
              "style": {
                "gap": "6px"
              }
            },
            "type": "ia.container.flex"
          },
          {
            "children": [
              {
                "meta": {
                  "name": "Now"
                },
                "propConfig": {
                  "props.text": {
                    "binding": {
                      "config": {
                        "path": "view.params.Status"
                      },
                      "type": "property"
                    }
                  }
                },
                "props": {
                  "style": {
                    "fontWeight": "600"
                  }
                },
                "type": "ia.display.label"
              }
            ],
            "meta": {
              "name": "Badge"
            },
            "props": {
              "style": {
                "backgroundColor": "{view.params.Color}",
                "borderRadius": "8px",
                "color": "#fff",
                "display": "inline-flex",
                "justifyContent": "center",
                "minWidth": "110px",
                "padding": "10px 14px"
              }
            },
            "type": "ia.container.flex"
          }
        ],
        "meta": {
          "name": "Body"
        },
        "props": {
          "alignItems": "center",
          "justify": "space-between"
        },
        "type": "ia.container.flex"
