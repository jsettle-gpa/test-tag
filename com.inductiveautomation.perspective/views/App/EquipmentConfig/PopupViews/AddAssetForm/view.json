        "hasCells": true,
        "infeedMult": 1,
        "infeedPath": "",
        "infeedUnit": "each",
        "name": "",
        "outfeedMult": 1,
        "outfeedPath": "",
        "outfeedUnit": "each",
        "rejectPath": "",
        "stateMode": ""
      }
    }
  },
  "params": {
    "selectedAssetData": {
      "EqEnabled": true,
      "EqID": 1,
      "EqMeta": {},
      "EqName": "GPA",
      "EqPath": "GPA",
      "EqType": "enterprise"
    }
  },
  "propConfig": {
    "custom.data": {
      "persistent": true
    },
    "custom.data.form": {
      "persistent": true
    },
    "custom.data.isLine": {
      "binding": {
        "config": {
          "path": "view.params.selectedAssetData.EqType"
        },
        "transforms": [
          {
            "code": "\tpt \u003d (value or \u0027\u0027).strip().lower()\n\t# Child is a LINE when parent is an AREA\n\treturn pt \u003d\u003d \u0027area\u0027",
            "type": "script"
          }
        ],
        "type": "property"
      }
    },
    "params.selectedAssetData": {
      "paramDirection": "input",
      "persistent": true
    }
  },
  "props": {
    "defaultSize": {
      "width": 900
    }
  },
