    "params.selectedRowData": {
      "onChange": {
        "enabled": null,
        "script": "\t\u0027\u0027\u0027 Writes the selectedRowData from the selection in the LineStates view table to the appropriate components \u0027\u0027\u0027\n\t\n\trowData \u003d currentValue.value\n\tif self.params.updateType \u003d\u003d \u0027edit\u0027:\n\t\tselection \u003d self.custom.data.selection\n\t\tselection[\u0027operatorSelectable\u0027] \u003d rowData.get(\u0027OperatorSelectable\u0027)\n\t\tselection[\u0027plannedDowntime\u0027] \u003d rowData.get(\u0027PlannedDowntime\u0027)\n\t\tselection[\u0027name\u0027] \u003d rowData.get(\u0027Description\u0027)\n\t\tselection[\u0027downtimeCategoryCode\u0027] \u003d rowData.get(\u0027DowntimeCategoryCode\u0027)\n\t\tselection[\u0027reasonCode\u0027] \u003d rowData.get(\u0027ReasonCode\u0027)\n\t\tselection[\u0027subReason\u0027] \u003d rowData.get(\u0027SubReasonOf\u0027)\n\t\tselection[\u0027recordDowntime\u0027] \u003d rowData.get(\u0027RecordDowntime\u0027)\n\t\tselection[\u0027stateTypeID\u0027] \u003d rowData.get(\u0027StateTypeID\u0027)"
      },
      "paramDirection": "input",
      "persistent": true
    },
    "params.updateType": {
      "paramDirection": "input",
      "persistent": true
    }
