    "custom.config.options": {
      "binding": {
        "config": {
          "path": "view.params.selectedRowData"
        },
        "transforms": [
          {
            "code": "\t\u0027\u0027\u0027 Gets the available options for the dropdowns \u0027\u0027\u0027\n\t\n\t# Calls backend function(s)\n\ttempData \u003d {\n\t\t\"boolOptions\": [\n\t\t\t{\n\t\t\t\t\"label\": \"No\",\n\t\t\t\t\"value\": False\n\t\t\t},\n\t\t\t{\n\t\t\t\t\"label\": \"Yes\",\n\t\t\t\t\"value\": True\n\t\t\t}\n\t\t\t],\n\t\t\t\"downtimeCategoryOptions\": [\n\t\t\t{\n\t\t\t\t\"label\": \"Test\",\n\t\t\t\t\"value\": 1\n\t\t\t}\n\t\t\t],\n\t\t\t\"reasonCodeOptions\": [\n\t\t\t{\n\t\t\t\t\"label\": \"Test\",\n\t\t\t\t\"value\": 1\n\t\t\t}\n\t\t\t],\n\t\t\t\"stateTypeOptions\": [\n\t\t\t{\n\t\t\t\t\"label\": \"Test\",\n\t\t\t\t\"value\": 1\n\t\t\t}\n\t\t\t],\n\t\t\t\"subReasonOptions\": [\n\t\t\t{\n\t\t\t\t\"label\": \"Test\",\n\t\t\t\t\"value\": 1\n\t\t\t}\n\t\t]\n\t}\n\treturn tempData",
            "type": "script"
          }
        ],
        "type": "property"
      }
    },
    "custom.data": {
      "persistent": true
    },
    "custom.data.selection.downtimeCategoryCode": {
      "binding": {
        "config": {
          "bidirectional": true,
