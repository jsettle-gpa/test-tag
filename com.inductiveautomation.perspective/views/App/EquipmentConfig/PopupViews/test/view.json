                      "config": {
                        "script": "\tself.view.custom.form \u003d {\n\t  \u0027EqName\u0027:\u0027\u0027, \u0027Enabled\u0027:True, \u0027HasCells\u0027:True, \u0027StateMode\u0027:\u0027\u0027, \u0027CountMode\u0027:\u0027\u0027,\n\t  \u0027WorkCenter\u0027:{\n\t    \u0027Infeed\u0027:{\u0027tag\u0027:\u0027\u0027,\u0027unit\u0027:\u0027each\u0027,\u0027multiplier\u0027:1},\n\t    \u0027Outfeed\u0027:{\u0027tag\u0027:\u0027\u0027,\u0027unit\u0027:\u0027each\u0027,\u0027multiplier\u0027:1},\n\t    \u0027Reject\u0027:{\u0027tag\u0027:\u0027\u0027}\n\t  }\n\t}"
                      },
