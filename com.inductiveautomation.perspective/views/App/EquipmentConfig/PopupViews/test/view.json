{
  "custom": {
    "form": {
      "CountMode": "",
      "Enabled": true,
      "EqName": "",
      "HasCells": true,
      "StateMode": "",
      "WorkCenter": {
        "Infeed": {
          "multiplier": 1,
          "tag": "",
          "unit": "each"
        },
        "Outfeed": {
          "multiplier": 1,
          "tag": "",
          "unit": "each"
        },
        "Reject": {
          "tag": ""
        }
      }
    },
    "show": {}
  },
  "params": {
    "EqData": {
      "EqEnabled": null,
      "EqID": null,
      "EqName": "",
      "EqPath": "",
      "EqType": ""
    }
  },
  "propConfig": {
    "custom.childType": {
      "binding": {
        "config": {
          "path": "view.params.EqData.EqType"
        },
        "transforms": [
          {
            "code": "\n\t# Map parent type -\u003e child type\n\tpt \u003d (value or u\u0027\u0027).strip().lower()\n\treturn {\n\t    \u0027\u0027: \u0027enterprise\u0027,\n\t    \u0027enterprise\u0027: \u0027site\u0027,\n\t    \u0027site\u0027: \u0027area\u0027,\n\t    \u0027area\u0027: \u0027line\u0027,\n\t    \u0027line\u0027: \u0027cell\u0027,\n\t    \u0027group\u0027: \u0027cell\u0027\n\t}.get(pt, \u0027cell\u0027)",
            "type": "script"
          }
        ],
        "type": "property"
      }
    },
    "custom.form": {
      "persistent": true
    },
    "custom.show.hasCells": {
      "binding": {
        "config": {
          "path": "view.custom.childType"
        },
        "transforms": [
          {
            "code": "\treturn value \u003d\u003d \u0027line\u0027",
            "type": "script"
          }
        ],
        "type": "property"
      }
    },
    "custom.show.workCenter": {
      "binding": {
        "config": {
          "struct": {
            "childType": "{view.custom.childType}",
            "hasCells": "{view.custom.form.HasCells}"
          },
          "waitOnAll": true
        },
        "transforms": [
          {
            "code": "\treturn (value.get(\u0027childType\u0027)\u003d\u003d\u0027line\u0027) and (not bool(value.get(\u0027hasCells\u0027)))",
            "type": "script"
          }
        ],
        "type": "expr-struct"
      }
    },
    "params.EqData": {
      "paramDirection": "input",
      "persistent": true
    }
  },
  "props": {
    "defaultSize": {
      "height": 420,
      "width": 700
    }
  },
