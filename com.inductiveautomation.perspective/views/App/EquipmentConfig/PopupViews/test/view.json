                  "text": "Clear"
                },
                "type": "ia.input.button"
              },
              {
                "events": {
                  "dom": {
                    "onClick": {
                      "config": {
                        "script": "\t\n\t# Compose payload and save\n\tparent \u003d dict(self.view.params.EqData or {})\n\tchildType \u003d self.view.custom.childType\n\tform \u003d dict(self.view.custom.form or {})\n\t\n\tpayload \u003d {\n\t\t\u0027ParentEqID\u0027: parent.get(\u0027EqID\u0027),\n\t\t\u0027ParentEqPath\u0027: parent.get(\u0027EqPath\u0027),\n\t\t\u0027ChildType\u0027: childType,\n\t\t\u0027EqName\u0027: form.get(\u0027EqName\u0027,\u0027\u0027).strip(),\n\t\t\u0027Enabled\u0027: bool(form.get(\u0027Enabled\u0027, True))\n\t}\n\t\n\t# If adding a Line as a work center (no cells), attach signals/config\n\tif childType \u003d\u003d \u0027line\u0027 and not bool(form.get(\u0027HasCells\u0027, True)):\n\t\tpayload[\u0027WorkCenter\u0027] \u003d form.get(\u0027WorkCenter\u0027, {})\n\t\tpayload[\u0027StateMode\u0027] \u003d form.get(\u0027StateMode\u0027,\u0027\u0027)\n\t\tpayload[\u0027CountMode\u0027] \u003d form.get(\u0027CountMode\u0027,\u0027\u0027)\n\t\tpayload[\u0027HasCells\u0027] \u003d False\n\telif childType \u003d\u003d \u0027line\u0027:\n\t\tpayload[\u0027HasCells\u0027] \u003d True\n\t\n\t# Basic input validation\n\tif not payload[\u0027EqName\u0027]:\n\t\tperiscope.toast(\u0027Name is required\u0027, \u0027warning\u0027)\n\t\treturn\n\t\n\ttry:\n\t\tres \u003d system.db.runNamedQuery(\u0027Equipment/Insert/add_asset\u0027, {\u0027PayloadJSON\u0027: system.util.jsonEncode(payload)})\n\t\tperiscope.toast(\u0027Asset created\u0027)\n\t\tsystem.perspective.sendMessage(\u0027refreshTree\u0027, {}, scope\u003d\u0027page\u0027)\n\t\tsystem.perspective.closePopup(self.view.id)\n\texcept:\n\t\tperiscope.toast(\u0027Save failed\u0027,\u0027error\u0027)"
                      },
                      "scope": "G",
                      "type": "script"
                    }
                  }
                },
                "meta": {
                  "name": "SaveButton"
                },
