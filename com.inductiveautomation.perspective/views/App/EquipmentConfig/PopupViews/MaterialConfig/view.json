                    "onClick": {
                      "config": {
                        "script": "\t\u0027\u0027\u0027 Updates the currentPane property \u0027\u0027\u0027\n\t\n\tcurrentPane \u003d self.view.custom.data.currentPane\n\tself.view.custom.data.currentPane \u003d currentPane - 1"
                      },
