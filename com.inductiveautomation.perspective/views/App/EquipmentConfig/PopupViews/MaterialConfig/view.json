      "messageHandlers": [
        {
          "messageType": "dataSourceSelection",
          "pageScope": true,
          "script": "\t\u0027\u0027\u0027 Recieves the data source selection from the SelectDataSource embedded view \u0027\u0027\u0027\n\t\n\t# Writes the incoming data to the custom properties\n\tdataSourceSelection \u003d self.view.custom.data.selection.dataSourceSelection\n\tdataSourceSelection[\u0027dataSource\u0027] \u003d payload.get(\u0027dataSource\u0027)\n\tdataSourceSelection[\u0027fileName\u0027] \u003d payload.get(\u0027fileName\u0027)\n\tdataSourceSelection[\u0027fileData\u0027] \u003d payload.get(\u0027fileData\u0027)",
          "sessionScope": false,
          "viewScope": false
        },
        {
          "messageType": "attributeSelection",
          "pageScope": true,
          "script": "\t\u0027\u0027\u0027 Recieves the attribute selections from the MapMaterialAttributes embedded view \u0027\u0027\u0027\n\t\n\t# Writes the incoming data to the custom properties\n\tself.view.custom.data.selection.attributeSelection \u003d payload.get(\u0027attributeSelection\u0027)",
          "sessionScope": false,
          "viewScope": false
        }
      ]
