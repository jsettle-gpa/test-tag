  "propConfig": {
    "custom.config": {
      "persistent": true
    },
    "custom.config.options": {
      "binding": {
        "config": {
          "path": "view.params.fileData"
        },
        "transforms": [
          {
            "code": "\t\u0027\u0027\u0027 Gets the options based on uploaded file \u0027\u0027\u0027\n\t\n\t# Gets the column names\n\tfileData \u003d self.params.fileData\n\theaders \u003d fileData.getColumnNames()\n\t\n\t# Loops through the headers and returns the dropdown options\n\toptions \u003d []\n\tfor header in headers:\n\t\toption \u003d {\n\t\t\t\u0027value\u0027: header,\n\t\t\t\u0027label\u0027: header\n\t\t}\n\t\toptions.append(option)\n\t\n\treturn options\n\t",
            "type": "script"
          }
        ],
        "type": "property"
      }
    },
    "custom.data": {
      "binding": {
        "config": {
          "struct": {
            "columns": {
              "description": "{/root/DescriptionContainer/Dropdown.props.value}",
              "endDate": "{/root/EndDateContainer/DropdownContainer/Dropdown.props.value}",
              "productCode": "{/root/ProductCodeContainer/Dropdown.props.value}",
              "requiredEndDate": "{/root/RequiredEndDateContainer/DropdownContainer/Dropdown.props.value}",
              "requiredQuantity": "{/root/RequiredQtyContainer/Dropdown.props.value}",
              "startDate": "{/root/StartDateContainer/DropdownContainer/Dropdown.props.value}",
              "workOrderNumber": "{/root/WorkOrderNumberContainer/Dropdown.props.value}"
            },
            "datetimeFormats": {
              "endDate": "{/root/EndDateContainer/DropdownContainer/FormatDropdown.props.value}",
              "requiredEndDate": "{/root/RequiredEndDateContainer/DropdownContainer/FormatDropdown.props.value}",
              "startDate": "{/root/StartDateContainer/DropdownContainer/FormatDropdown.props.value}"
            },
            "fileData": "{view.params.fileData}"
          },
          "waitOnAll": true
        },
        "transforms": [
          {
            "code": "\t\u0027\u0027\u0027 Gets the selections, checks for any errors from the dropdown selections, and then sends a message to the MaterialConfig popup view (parent view) with the selections \u0027\u0027\u0027\n\t\n\t# Gets the selections\n\tselections \u003d {\n\t\t\u0027columns\u0027: value.columns,\n\t\t\u0027datetimeFormats\u0027: value.datetimeFormats\n\t}\n\t\n\t# Gets the inputErrors\n\tinputErrors \u003d assetConfig.util.invalidInputCheck(value.fileData, selections)\n\t\n\t\n\t# --- Sends a message to the attributeSelection message handler on the root of the MaterialConfig  popup view ---\n\t\n\t# Checks if all selections have been made and that there are no input errors\n\tattributeSelection \u003d selections[\u0027columns\u0027]\n\tallSelectionsMade \u003d all(selection for selection in attributeSelection.values())\n\tnoInputErrors \u003d all(val \u003d\u003d \u0027\u0027 for val in inputErrors.values())\n\t\n\t# Sends the message to the handler, sends selected attributes if allSelectionsMade and noInputErrors, else clears it\n\tif allSelectionsMade and noInputErrors:\n\t\tpayload \u003d {\n\t\t\t\u0027attributeSelection\u0027: attributeSelection\n\t\t}\n\telse:\n\t\tpayload \u003d {\n\t\t\t\u0027attributeSelection\u0027: {}\n\t\t}\n\tsystem.perspective.sendMessage(\u0027attributeSelection\u0027, payload)\n\t\n\t# Gets and returns the data property\n\tdata \u003d {\n\t\t\u0027selections\u0027: selections,\n\t\t\u0027inputErrors\u0027: inputErrors\n\t}\n\treturn data",
            "type": "script"
          }
        ],
        "type": "expr-struct"
      },
      "persistent": true
    },
    "params.fileData": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.fileName": {
      "paramDirection": "input",
      "persistent": true
    }
  },
