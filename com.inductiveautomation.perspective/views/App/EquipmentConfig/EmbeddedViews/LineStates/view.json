    "custom.config": {
      "persistent": true
    },
    "custom.config.tableData": {
      "binding": {
        "config": {
          "path": "view.params.selectedAssetData"
        },
        "transforms": [
          {
            "code": "\t\u0027\u0027\u0027 Gets the data for the table \u0027\u0027\u0027\n\t\n\t# Call to backend function(s)\n\ttempHeaders \u003d [\n\t\t\u0027Description\u0027,\n\t\t\u0027ReasonCode\u0027,\n\t\t\u0027RecordDowntime\u0027,\n\t\t\u0027PlannedDowntime\u0027,\n\t\t\u0027OperatorSelectable\u0027,\n\t\t\u0027SubReasonOf\u0027,\n\t\t\u0027StateTypeID\u0027,\n\t\t\u0027DowntimeCategoryCode\u0027,\n\t]\n\t\n\ttempRows \u003d [\n\t\t[\u0027Disabled\u0027,0,True,False,True,-1,0,1],\n\t\t[\u0027Running\u0027,1,False,False,True,-1,0,1],\n\t\t[\u0027Change Over\u0027,2,True,False,True,-1,3,1]\n\t]\n\ttempData \u003d system.dataset.toDataSet(tempHeaders, tempRows)\n\n\treturn tempData",
            "type": "script"
          }
        ],
        "type": "property"
      }
    },
    "custom.data": {
      "persistent": true
    },
    "custom.data.selectedRowData": {
      "binding": {
        "config": {
          "path": "/root/TableContainer/Table.props.selection.data"
        },
        "type": "property"
      }
    },
    "params.selectedAssetData": {
      "paramDirection": "input",
      "persistent": true
    }
  },
  "props": {
    "defaultSize": {
      "height": 498,
      "width": 894
