                  "basis": "110px",
                  "shrink": 0
                },
                "props": {
                  "primary": false,
                  "text": "Clear"
                },
                "type": "ia.input.button"
              },
              {
                "events": {
                  "dom": {
                    "onClick": {
                      "config": {
                        "script": "\t\"\"\"\n\tCollects the form fields, builds the JSON payload, \n\tand calls the saveConfig message handler for the first-time insert.\n\t\"\"\"\n\t# Grab all form values\n\tassetName          \u003d self.parent.parent.getChild(\"NameContainer\").getChild(\"TextField\").props.text\n\tassetEnabled       \u003d self.parent.parent.getChild(\"DisabledContainer\").getChild(\"Checkbox\").props.selected\n\tmodeEntry          \u003d self.parent.parent.getChild(\"ModeEntryContainer\").getChild(\"Dropdown\").props.value\n\tstateDetection     \u003d self.parent.parent.getChild(\"StateDetectionContainer\").getChild(\"Dropdown\").props.value\n\tmicrostopDuration  \u003d self.parent.parent.getChild(\"MicrostopDurationContainer\").getChild(\"TextField\").props.text\n\tdefaultRate        \u003d self.parent.parent.getChild(\"DefaultRateContainer\").getChild(\"TextField\").props.text\n\trunningRate        \u003d self.parent.parent.getChild(\"RunningRateContainer\").getChild(\"TextField\").props.text\n\trunningDuration    \u003d self.parent.parent.getChild(\"RunningDurationContainer\").getChild(\"TextField\").props.text\n\tstoppedRate        \u003d self.parent.parent.getChild(\"StoppedRateContainer\").getChild(\"TextField\").props.text\n\tstoppedDuration    \u003d self.parent.parent.getChild(\"StoppedDurationContainer\").getChild(\"TextField\").props.text\n\t\n\t# 2) defaultSettings block\n\tdefaultSettings \u003d {\n\t\t\"assetName\":         assetName,\n\t\t\"assetEnabled\":      assetEnabled,\n\t\t\"modeEntry\":         modeEntry,\n\t\t\"stateDetection\":    stateDetection,\n\t\t\"microstopDuration\": microstopDuration,\n\t\t\"defaultRate\":       defaultRate,\n\t\t\"runningRate\":       runningRate,\n\t\t\"runningDuration\":   runningDuration,\n\t\t\"stoppedRate\":       stoppedRate,\n\t\t\"stoppedDuration\":   stoppedDuration\n\t}\n\n\t# 3) Wrap it under the top‐level key\n\tconfigPayload \u003d {\n\t\t\"defaultSettings\": defaultSettings\n\t}\n\n\t# get the equipmentId\n\tequipmentId \u003d self.view.params.selectedAssetData[\"assetID\"]\n\n\t#send request\n\tsuccess \u003d assetConfig.requests.saveEquipmentConfig(equipmentId, { \"defaultSettings\": defaultSettings })\n\n\t# get results\n\tif success:\n\t\tsystem.perspective.print(\"Configuration saved!\")\n\t\tsystem.perspective.sendMessage(\u0027refreshTree\u0027)\n\telse:\n\t\tsystem.perspective.print(\"Error saving configuration.\")"
                      },
                      "scope": "G",
                      "type": "script"
                    }
                  }
