              {
                "events": {
                  "dom": {
                    "onClick": {
                      "config": {
                        "script": "\t\u0027\u0027\u0027 Clears the properties form \u0027\u0027\u0027\n\t\n\tself.parent.parent.getChild(\"NameContainer\").getChild(\"TextField\").props.text \u003d \u0027\u0027\n\tself.parent.parent.getChild(\"DisabledContainer\").getChild(\"Checkbox\").props.selected \u003d False\n\tself.parent.parent.getChild(\"ModeEntryContainer\").getChild(\"Dropdown\").props.value \u003d \u0027\u0027\n\tself.parent.parent.getChild(\"StateDetectionContainer\").getChild(\"Dropdown\").props.value \u003d \u0027\u0027\n\tself.parent.parent.getChild(\"MicrostopDurationContainer\").getChild(\"TextField\").props.text \u003d \u0027\u0027\n\tself.parent.parent.getChild(\"DefaultRateContainer\").getChild(\"TextField\").props.text \u003d \u0027\u0027\n\tself.parent.parent.getChild(\"RunningRateContainer\").getChild(\"TextField\").props.text \u003d \u0027\u0027\n\tself.parent.parent.getChild(\"RunningDurationContainer\").getChild(\"TextField\").props.text \u003d \u0027\u0027\n\tself.parent.parent.getChild(\"StoppedRateContainer\").getChild(\"TextField\").props.text \u003d \u0027\u0027\n\tself.parent.parent.getChild(\"StoppedDurationContainer\").getChild(\"TextField\").props.text \u003d \u0027\u0027\n\t"
                      },
                      "scope": "G",
                      "type": "script"
                    }
