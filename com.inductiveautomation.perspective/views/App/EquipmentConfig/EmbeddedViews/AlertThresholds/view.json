{
  "custom": {
    "config": {}
  },
  "params": {
    "selectedAssetData": {
      "assetEnabled": true,
      "assetID": 2,
      "assetName": "Cell 1",
      "assetPath": "GPA/Wilmington/Molding/Line 2/Cell 1",
      "assetType": "cell"
    }
  },
  "propConfig": {
    "custom.config": {
      "persistent": true
    },
    "custom.config.assetThresholds": {
      "binding": {
        "config": {
          "path": "view.params.selectedAssetData"
        },
        "transforms": [
          {
            "code": "\t\u0027\u0027\u0027 Gets the current asset threshold values \u0027\u0027\u0027\n\t\n\t# Calls backend script(s)\n\ttempData \u003d {\n\t\t\u0027performance\u0027: \u002775\u0027,\n\t\t\u0027rejectPercentage\u0027: \u002710\u0027\n\t}\n\t\n\treturn tempData",
            "type": "script"
          }
        ],
        "type": "property"
      }
    },
    "params.selectedAssetData": {
      "paramDirection": "input",
      "persistent": true
    }
  },
  "props": {},
  "root": {
    "children": [
      {
        "children": [
          {
            "meta": {
              "name": "HeaderLabel"
            },
            "position": {
              "basis": "300px",
              "shrink": 0
            },
            "propConfig": {
              "props.text": {
                "binding": {
                  "config": {
                    "path": "view.params.selectedAssetData.assetType"
                  },
                  "transforms": [
                    {
                      "code": "\t\u0027\u0027\u0027 Formats the string for the header \u0027\u0027\u0027\n\tlabel \u003d value.capitalize() + \u0027 Performance (Minimum):\u0027\n\treturn label",
                      "type": "script"
                    }
                  ],
                  "type": "property"
                }
              }
            },
            "props": {
              "style": {
                "fontSize": "1rem",
                "fontWeight": "bold",
                "textAlign": "right"
              }
            },
            "type": "ia.display.label"
          },
          {
            "meta": {
              "name": "TextField"
            },
            "position": {
              "basis": "300px"
            },
            "propConfig": {
              "props.text": {
                "binding": {
                  "config": {
                    "bidirectional": true,
                    "path": "view.custom.config.assetThresholds.performance"
                  },
                  "type": "property"
                }
              }
            },
            "props": {
              "placeholder": "Enter a value...",
              "style": {
                "fontSize": "0.8rem",
                "marginLeft": "15px"
              }
            },
            "type": "ia.input.text-field"
          }
        ],
        "meta": {
          "name": "AssetPerformanceContainer"
        },
        "position": {
          "basis": "40px",
          "shrink": 0
        },
        "props": {
          "justify": "center",
          "style": {
            "marginLeft": "15px",
            "marginRight": "15px",
            "marginTop": "15px",
            "overflow": "hidden"
          }
        },
        "type": "ia.container.flex"
      },
      {
        "children": [
          {
            "meta": {
              "name": "HeaderLabel"
            },
            "position": {
              "basis": "300px",
              "shrink": 0
            },
            "props": {
              "style": {
                "fontSize": "1rem",
                "fontWeight": "bold",
                "textAlign": "right"
              },
              "text": "Reject Percentage (Per Hour):"
            },
            "type": "ia.display.label"
          },
          {
            "meta": {
              "name": "TextField"
            },
            "position": {
              "basis": "300px"
            },
            "propConfig": {
              "props.text": {
                "binding": {
                  "config": {
                    "bidirectional": true,
                    "path": "view.custom.config.assetThresholds.rejectPercentage"
                  },
                  "type": "property"
                }
              }
            },
            "props": {
              "placeholder": "Enter a value...",
              "style": {
                "fontSize": "0.8rem",
                "marginLeft": "15px"
              }
            },
            "type": "ia.input.text-field"
          }
        ],
        "meta": {
          "name": "RejectPercentageContainer"
        },
        "position": {
          "basis": "40px",
          "shrink": 0
        },
        "props": {
          "justify": "center",
          "style": {
            "marginLeft": "15px",
            "marginRight": "15px",
            "marginTop": "15px",
            "overflow": "hidden"
          }
        },
        "type": "ia.container.flex"
      },
      {
        "meta": {
          "name": "Spacer"
        },
        "position": {
          "grow": 1
        },
        "type": "ia.display.label"
      },
      {
        "children": [
          {
            "events": {
              "dom": {
                "onClick": {
                  "config": {
                    "script": "\t\u0027\u0027\u0027 Saves the form data to the database \u0027\u0027\u0027\n\t\n\t# Gets all the form values\n\tassetThresholds \u003d self.view.custom.config.assetThresholds\n\tcellPerformance \u003d assetThresholds.get(\u0027cellPerformance\u0027)\n\trejectPercentage \u003d assetThresholds.get(\u0027rejectPercentage\u0027)\n\t\n\t# Calls the backend script(s)\n\t"
                  },
                  "scope": "G",
                  "type": "script"
                }
              }
            },
            "meta": {
              "name": "SaveButton",
              "tooltip": {
                "enabled": true,
                "text": "View 8-hour plots for the mapped tags"
              }
            },
            "position": {
              "basis": "110px",
              "shrink": 0
            },
            "props": {
              "text": "Save"
            },
            "type": "ia.input.button"
          }
        ],
        "meta": {
          "name": "ButtonContainer"
        },
        "position": {
          "basis": "45px",
          "shrink": 0
        },
        "props": {
          "justify": "space-evenly",
          "style": {
            "marginBottom": "15px",
            "marginTop": "15px",
            "overflow": "visible"
          }
        },
        "type": "ia.container.flex"
      }
    ],
    "meta": {
      "name": "root"
    },
    "props": {
      "direction": "column",
      "style": {
        "margin": "15px"
      }
    },
    "type": "ia.container.flex"
  }
}