  "propConfig": {
    "custom.data": {
      "persistent": true
    },
    "custom.data.finalData": {
      "binding": {
        "config": {
          "path": "view.custom.data.selection"
        },
        "transforms": [
          {
            "code": "\t\u0027\u0027\u0027 Creates a new dataset with the attribute name as the header and the selected data \u0027\u0027\u0027\n\t\n\t# Gets the file data and selections\n\tfileData \u003d self.custom.data.selection.dataSourceSelection.fileData\n\tattributeSelection \u003d value.attributeSelection\n\t\n\t# Returns a not ready message if not all selections have been made\n\tif not fileData or not attributeSelection:\n\t\treturn \u0027Final data not ready, make selections first\u0027\n\t\n\t# Loops through the original data set, filters out the unused data, and gets a list of column names (used for the headers)\n\tdata \u003d []\n\tcolumnNames \u003d []\n\tfor row in range(fileData.getRowCount()):\n\t\trowData \u003d []\n\t\tfor col in range(fileData.getColumnCount()):\n\t\t\tcolumnName \u003d fileData.getColumnName(col)\n\t\t\tif columnName in attributeSelection.values():\n\t\t\t\trowData.append(fileData.getValueAt(row, col))\n\t\t\t\tif columnName not in columnNames:\n\t\t\t\t\tcolumnNames.append(columnName)\n\t\t\telse:\n\t\t\t\tcontinue\n\t\tdata.append(rowData)\n\t\n\t# Updates the headers to the attribute names\n\theaderMapping \u003d {value: key for key, value in attributeSelection.items()}\n\theaders \u003d [headerMapping.get(header, header) for header in columnNames]\n\t\n\t# Creates the final dataset and returns it\n\tfinalData \u003d system.dataset.toDataSet(headers, data)\n\treturn finalData",
            "type": "script"
          }
        ],
        "type": "property"
      }
    },
    "params.domainMapingSelections": {
      "paramDirection": "inout",
      "persistent": true
    },
    "params.erpData": {
      "binding": {
        "config": {
          "connectTimeout": 60000,
          "enableCookies": true,
          "enableValueCache": false,
          "polling": {
            "enabled": false,
            "rate": "5000"
          },
          "request": {
            "auth": {
              "type": "None",
              "value": ""
            },
            "method": "GET",
            "url": "\"http://172.16.150.37:8000/work-orders\""
          },
          "socketTimeout": 60000
        },
        "enabled": false,
        "type": "http"
      },
      "paramDirection": "output",
      "persistent": true
    },
    "params.finalData": {
      "binding": {
        "config": {
          "path": "view.params.domainMapingSelections"
        },
        "enabled": false,
        "transforms": [
          {
            "code": "\n\n    headers \u003d [\"Domain\", \"MES Value\", \"ERP Value\"]\n    rows \u003d []\n\n    if not value:\n        return system.dataset.toDataSet(headers, rows)\n\n    for item in value:\n\n        # Handle Java Map (Ignition) and Python dict\n        if hasattr(item, \"get\"):\n            vp \u003d item.get(\"viewParams\")\n            src \u003d vp if vp is not None else item\n        else:\n            src \u003d item.get(\"viewParams\", item)\n\n        # Extract fields\n        domain \u003d src.get(\"domain\") if src else None\n        mes \u003d src.get(\"mesValue\") if src else None\n        sel \u003d src.get(\"selectedERP\") if src else None\n\n        rows.append([domain, mes, sel])\n\n    return system.dataset.toDataSet(headers, rows)",
            "type": "script"
          }
        ],
        "type": "property"
      },
      "paramDirection": "output",
      "persistent": true
    },
    "params.mesData": {
      "binding": {
        "config": {
          "queryPath": "App/Admin/Read/get_all_mes_column_headers"
        },
        "enabled": false,
        "type": "query"
      },
      "paramDirection": "output",
      "persistent": true
    }
  },
