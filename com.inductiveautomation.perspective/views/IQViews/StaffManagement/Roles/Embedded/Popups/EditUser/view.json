int(self.session.props.auth.user.roles)\n\t\t\n\t\tparams \u003d {\n\t\t\t\"userId\" : userId,\n\t\t\t\"newUserId\": newUserId,\n\t\t\t\"firstName\" : firstName, \n\t\t\t\"lastName\" : lastName,\n\t\t\t\"email\" : email,\n\t\t\t\"badge\" : badge\n\t\t}\n\t\t\n\t\tif userId not in (\u0027\u0027, None):\t\n\t\t\tres \u003d system.db.runNamedQuery(\"auth/updateUser\", params)\n\n\t\t\tif res[0][0] !\u003d \u0027Success\u0027: \n\t\t\t\tsystem.perspective.closePopup(self.view.params.ModalName)\n\t\t\t\traise ValueError(str(res[0][0]))\n\t\t\t\t\n\t\t\t#Update role assignments\n\t\t\t#Remove all current roles\n\t\t\tsystem.db.runNamedQuery(\"auth/removeUserRoles\", { \"userId\": userId })\n\t\t\t#Assign roles from assignedRoleData\n\t\t\tfor row in system.dataset.toPyDataSet(assignedRolesData):\n\t\t\t\tparams \u003d {\n\t\t\t\t\t\"userId\" : userId,\n\t\t\t\t\t\"roleName\" : row[\u0027RoleName\u0027]\n\t\t\t\t}\n\t\t\t\tsystem.db.runNamedQuery(\"auth/assignRole\", params)\n\t\t\t\n\t\t\tsystem.perspective.sendMessage(\u0027refreshUserTable\u0027)\n\t\t\tsystem.perspective.closePopup(self.view.params.ModalName)\n\t\telse:\n\t\t\traise Exception(\"User Id can\u0027t be blank.\")\n\texcept Exception as e:\n\t    gpa.frontEnd.localUI.throwError(e)\n\telse:\n\t\tgpa.frontEnd.localUI.throwSuccess(\u0027Updated user \u0027 + userId)"
                      },
