                "children": [
                  {
                    "events": {
                      "dom": {
                        "onClick": {
                          "config": {
                            "script": "\tif self.meta.enabled:\n\t\tavailableRolesCurrData \u003d self.parent.parent.getChild(\"Col2\").getChild(\"Table\").props.data\n\t\tselectedRole \u003d self.parent.parent.getChild(\"Col4\").getChild(\"Table\").props.selection.data\n\t\tassignedRolesCurrData \u003d self.parent.parent.getChild(\"Col4\").getChild(\"Table\").props.data\n\n\t\t#Remove from assigned role\n\t\tcolKey \u003d \u0027RoleName\u0027\n\t\tidsToRemoveOnMatch \u003d [row[colKey] for row in selectedRole]\n\t\trowsToKeep \u003d []\n\t\t\n\t\tassignedRolesDataSet \u003d system.dataset.toPyDataSet(assignedRolesCurrData)\n\t\tcolumnNames \u003d list(assignedRolesDataSet.getColumnNames())\n\t\t\n\t\tfor row in assignedRolesDataSet:\n\t\t\tif row[colKey] not in idsToRemoveOnMatch:\n\t\t\t\trowsToKeep.append(list(row))\n\n\t\t# Convert rowsToKeep back to a Dataset with the original column names\n\t\tupdatedDataSet \u003d system.dataset.toDataSet(columnNames, rowsToKeep)\n\t\tself.parent.parent.getChild(\"Col4\").getChild(\"Table\").props.data \u003d updatedDataSet\n\n\t\t#Add to available roles\n\t\tavailableRolesDataSet \u003d system.dataset.toPyDataSet(availableRolesCurrData)\n\n\t\theaders \u003d []\n\t\tdata \u003d []\n\t\tfor row in selectedRole:\n\t\t\tif not headers:\n\t\t\t\theaders \u003d row.keys()\n\t\t\tdata.append([val for key,val in row.iteritems()])\n\t\tselectedRolesDataSet \u003d system.dataset.toPyDataSet(system.dataset.toDataSet(headers, data))\n\n\t\t#Sort columns\n\t\tsortedCols \u003d assignedRolesCurrData.getColumnNames()\n\t\trowToAdd \u003d selectedRolesDataSet[0]\n\t\tsortedRow \u003d [rowToAdd[selectedRolesDataSet.getColumnIndex(col)] for col in sortedCols]\n\n\t\t#Add to original dataset\n\t\tnewDataSet \u003d system.dataset.addRow(availableRolesDataSet, sortedRow)\n\t\tself.parent.parent.getChild(\"Col2\").getChild(\"Table\").props.data \u003d newDataSet"
                          },
                          "scope": "G",
                          "type": "script"
                        }
                      }
