                "events": {
                  "dom": {
                    "onClick": {
                      "config": {
                        "script": "\timport json\n\ttry:\n\t\t#get current list of favorite icons\n\t\t#expected structure: [{\u0027target\u0027: \u0027/home\u0027, \u0027iconPath\u0027: \u0027elev8/home\u0027}] will be in string type, needs conversion\n\t\tcustomIcons \u003d self.session.custom.favoriteIcons\n\t\t#gets rid of the last entry which is the hard coded cog wheel\n\t\tcustomIcons.pop()\n\t\t#system.perspective.print(str(customIcons))\n\t\tif not self.parent.parent.parent.getChild(\"FlexContainer\").custom.postIsDisabled:\n\t\t\tformattedCustomIcons \u003d []\n\t\t\tif self.props.path \u003d\u003d \u0027elev8/star_border\u0027:\n\t\t\t\t#favoriting\n\t\t\t\tself.props.path \u003d \u0027elev8/star\u0027\n\t\t\t\tcustomIcons.append({\"target\": self.view.params.target, \"iconPath\": self.view.params.icon, \"tooltip\": self.view.params.optionText})\n\t\t\t\tformattedCustomIcons \u003d system.util.jsonEncode(customIcons)\n\t\t\telse:\n\t\t\t\t\n\t\t\t\t#unfavoriting\n\t\t\t\t#for whatever reason we need to put it into the converter and make sure its a dataset first\n\t\t\t\theaders \u003d [\"favorite_icons\"]\n\t\t\t\tdata \u003d []\n\t\t\t\tdata.append([\"[]\"])\n\t\t\t\ttemp \u003d system.dataset.toDataSet(headers, data)\n\t\t\t\tformattedTemp \u003d gpa.frontEnd.localUI.getDashboardArray(temp, 0)\n\t\t\t\t#system.perspective.print(formattedTemp)\n\t\t\t\tself.props.path \u003d \u0027elev8/star_border\u0027\n\t\t\t\tfor index, item in enumerate(customIcons):\n\t\t\t\t\t#system.perspective.print(\u0027comparing: \u0027 + self.view.params.target + \u0027 to \u0027 + item[\"target\"])\n\t\t\t\t\tif(self.view.params.target !\u003d item[\"target\"]):\n\t\t\t\t\t\t#we are trying to get rid of the one that matches so we dont want to add it to the formatted Icons\n\t\t\t\t\t\t#system.perspective.print(\u0027item: \u0027+ str(item))\n\t\t\t\t\t\tclean_item \u003d {str(k): str(v) for k, v in item.items()}\n\t\t\t\t\t\tformattedTemp.append(clean_item)\n\t\t\t\ttry:\n\t\t\t\t\t#system.perspective.print(formattedTemp)\n\t\t\t\t\tformattedCustomIcons \u003d json.dumps(formattedTemp)\n\t\t\t\texcept Exception as e:\n\t\t\t\t\tsystem.perspective.print(\u0027deeper: \u0027+str(e))\n\t\t\t\t\t\n\t\t\tsystem.db.runNamedQuery(\u0027app/UserSettings/sidebar/upsertSidebar\u0027, parameters \u003d {\"FavoriteObjArray\": formattedCustomIcons, \"userName\": self.session.props.auth.user.userName})\n\t\t\tself.session.refreshBinding(\u0027custom.favoriteIcons\u0027)\n\texcept Exception as e:\n\t\tsystem.perspective.print(e)"
                      },
                      "scope": "G",
                      "stopPropagation": true,
                      "type": "script"
