{
  "custom": {
    "activeAlarms": 0,
    "inputs": {}
  },
  "params": {
    "Kiosk": false,
    "curentPage": "",
    "pagePath": ""
  },
  "propConfig": {
    "custom.inputs": {
      "persistent": true
    },
    "custom.inputs.User": {
      "binding": {
        "config": {
          "expression": "trim(coalesce({session.props.auth.user.firstName}, \u0027\u0027)) \r\n+ if(\r\n    len(trim(coalesce({session.props.auth.user.lastName}, \u0027\u0027))) \u003e 0,\r\n    \u0027 \u0027,\r\n    \u0027\u0027\r\n  ) \r\n+ trim(coalesce({session.props.auth.user.lastName}, \u0027\u0027))"
        },
        "type": "expr"
      }
    },
    "custom.inputs.timeFormat": {
      "binding": {
        "config": {
          "expression": "try(\r\n\tdateFormat(\r\n\t\tnow(10000),\r\n\t\treplace(replace({session.custom.UserSettings.App.TimeFormat}, \"DD\", \"dd\"), \"YYYY\", \"yyyy\")\r\n \r\n\t),\r\n\tnow(10000)\r\n)"
        },
        "type": "expr"
      }
    },
    "params.curentPage": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.pagePath": {
      "paramDirection": "input",
      "persistent": true
    }
  },
  "props": {
    "defaultSize": {
      "height": 65,
      "width": 1900
    }
  },
  "root": {
    "children": [
      {
        "children": [
          {
            "meta": {
              "name": "Logo"
            },
            "position": {
              "basis": "26px",
              "display": false
            },
            "props": {
              "altText": "Logo",
              "fit": {
                "height": 50,
                "mode": "contain",
                "width": 50
              },
              "source": "/system/images/6.png",
              "style": {
                "marginBottom": 5,
                "marginTop": 5
              }
            },
            "type": "ia.display.image"
          },
          {
            "meta": {
              "domId": "header-menu-icon",
              "name": "Menu"
            },
            "position": {
              "basis": "30px"
            },
            "props": {
              "color": "white",
              "path": "material/menu",
              "style": {
                "opacity": 0.9
              }
            },
            "type": "ia.display.icon"
          }
        ],
        "meta": {
          "name": "Menu"
        },
        "position": {
          "basis": "60px"
        },
        "props": {
          "alignItems": "center",
          "direction": "column",
          "style": {
            "gap": "",
            "marginRight": "10px",
            "overflow": "hidden"
