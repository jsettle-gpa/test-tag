        "type": "ia.input.fileupload"
      },
      {
        "children": [
          {
            "events": {
              "dom": {
                "onClick": {
                  "config": {
                    "script": "\t# logger \u003d system.util.getLogger(\"importFile\")\n\t\n\ttry:\n\t\t# 1 [importFile] Start import\n\t\t# logger.info(\"1 [importFile] Start import. Type\u003d%s EqType\u003d%s\" % (self.view.params.Type, self.view.params.EqType))\n\t\n\t\t# 2 [importFile] Grab upload data\n\t\tcsvFile \u003d self.parent.parent.getChild(\"FileUpload\").custom.configCSV\n\t\tcsvDS \u003d self.parent.parent.getChild(\"FileUpload\").custom.csvDict\n\t\tEqType \u003d self.view.params.EqType\n\t\tpayload \u003d { \"csvString\": csvFile, \"csvDS\": csvDS, \"EqType\": EqType }\n\t\t# logger.info(\"2 [importFile] Data grabbed. Rows\u003d%s Cols\u003d%s\" % (csvDS.getRowCount(), csvDS.getColumnCount()))\n\t\t\n\t\t# → Add these two lines:\n\t\t# logger.info(\"2.1 [importFile] csvString:\\n\" + str(csvFile))\n\t\t# logger.info(\"2.2 [importFile] csvDS:\\n\" + str(system.dataset.toCSV(csvDS)))\n\n\t\t# 3 [importFile] Determine message type\n\t\ttype_map \u003d {\n\t\t\t\"states\": \"importStates\",\n\t\t\t\"modes\": \"importModes\",\n\t\t\t\"scrapCategory\": \"importScrapCategory\",\n\t\t\t\"scrapReasons\": \"importScrapReasons\",\n\t\t\t\"materials\": \"importMaterials\",\n\t\t\t\"sites\": \"importSites\",\n\t\t\t\"areas\": \"importAreas\",\n\t\t\t\"lines\": \"importLines\",\n\t\t\t\"cells\": \"importCells\",\n\t\t\t\"attributes\": \"importAttributes\",\n\t\t\t\"productcodes\": \"importProductCodes\"\n\t\t}\n\t\tmessageType \u003d type_map.get(self.view.params.Type)\n\t\tif messageType:\n\t\t\t# logger.info(\"3 [importFile] Dispatching message: %s\" % messageType)\n\t\t\tsystem.perspective.sendMessage(messageType, payload)\n\t\telse:\n\t\t\t# logger.info(\"3 [importFile] No matching messageType found.\")\n\t\t\tpass\n\t\n\t\t# 4 [importFile] Clear input\n\t\tself.parent.parent.getChild(\"FileUpload\").custom.configCSV \u003d \"\"\n\t\tsystem.dataset.clearDataset(csvDS)\n\t\t# logger.info(\"4 [importFile] Cleared input buffers\")\n\t\n\t\t# 5 [importFile] Import routine complete\n\t\t# logger.info(\"5 [importFile] Import routine complete\")\n\t\n\texcept Exception as e:\n\t\t# logger.info(\"6 [importFile] ERROR: %s\" % str(e))\n\t\tpass\n\t\n\tpass"
                  },
                  "scope": "G",
                  "type": "script"
                }
              }
            },
            "meta": {
              "name": "Import"
            },
            "position": {
              "basis": "80px"
            },
            "propConfig": {
              "props.enabled": {
                "binding": {
                  "config": {
