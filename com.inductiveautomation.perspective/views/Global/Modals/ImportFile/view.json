            "onUploadsCleared": {
              "config": {
                "script": "\t# logger \u003d system.util.getLogger(\"importFile\")\n\t\n\ttry:\n\t\t# logger.info(\"1.. [clearUpload] configCSV cleared\")\n\t\t# 1 [clearUpload] Clear configCSV\n\t\tself.custom.configCSV \u003d \u0027\u0027\n\t\t# logger.info(\"1 [clearUpload] configCSV cleared\")\n\texcept Exception as e:\n\t\t# logger.info(\"2 [clearUpload] ERROR: %s\" % str(e))\n\t\tpass\n\t\n\tpass"
              },
              "scope": "G",
              "type": "script"
            }
