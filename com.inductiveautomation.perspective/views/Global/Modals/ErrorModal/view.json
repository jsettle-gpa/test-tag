  "propConfig": {
    "custom.Error": {
      "binding": {
        "config": {
          "expression": "if(indexOf({/root/FlexContainer/Markdown.props.source}, \"error\") \u003e\u003d 0||indexOf({/root/FlexContainer/Markdown.props.source}, \"Error\") \u003e\u003d 0,\r\n true, if(indexOf({/root/FlexContainer/Markdown.props.source}, \"fail\") \u003e\u003d0||indexOf({/root/FlexContainer/Markdown.props.source}, \"Fail\") \u003e\u003d0, true, false))"
        },
        "type": "expr"
      },
      "persistent": true
    },
    "custom.Success": {
      "binding": {
        "config": {
          "expression": "if(indexOf({/root/FlexContainer/Markdown.props.source}, \"success\") \u003e\u003d 0||indexOf({/root/FlexContainer/Markdown.props.source}, \"Success\") \u003e\u003d 0, true, false)"
        },
        "type": "expr"
      },
      "persistent": true
    },
    "custom.Warning": {
      "binding": {
        "config": {
          "expression": "indexof(lower({view.params.ErrorMessage}), \u0027warning\u0027) \u003e\u003d 0"
        },
        "type": "expr"
      },
      "persistent": true
