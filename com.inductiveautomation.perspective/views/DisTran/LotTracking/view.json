              {
                "meta": {
                  "name": "QueueTable"
                },
                "position": {
                  "basis": "fill",
                  "grow": 1
                },
                "propConfig": {
                  "props.data": {
                    "binding": {
                      "config": {
                        "path": "view.custom.Queue"
                      },
                      "type": "property"
                    }
                  }
                },
                "props": {
                  "columns": [
                    {
                      "field": "Part",
                      "header": {
                        "title": "Part"
                      }
                    },
                    {
                      "field": "WorkOrder",
                      "header": {
                        "title": "WO"
                      }
                    },
                    {
                      "field": "Qty",
                      "header": {
                        "title": "Qty"
                      }
                    },
                    {
                      "field": "Priority",
                      "header": {
                        "title": "Pri"
                      }
                    }
                  ],
                  "selection": {
                    "enabled": true,
                    "mode": "multiple"
                  },
                  "style": {
                    "height": "100%"
                  }
                },
                "type": "ia.display.table"
              },
              {
                "children": [
                  {
                    "events": {
                      "component": {
                        "onActionPerformed": {
                          "config": {
                            "script": "qtbl \u003d self.getSibling(\u0027QueueTable\u0027)\nsel \u003d list(qtbl.props.selection.get(\u0027rows\u0027) or [])\nqrows \u003d list(qtbl.props.data or [])\nchosen \u003d [qrows[i] for i in sel]\nstack \u003d list(self.view.custom.StackRows or [])\nempties \u003d [r for r in stack if not r.get(\u0027QueueItemID\u0027)]\nimport itertools\nfor row, slot in itertools.izip(chosen, empties):\n    slot[\u0027QueueItemID\u0027] \u003d row.get(\u0027QueueItemID\u0027)\n    slot[\u0027Part\u0027] \u003d row.get(\u0027Part\u0027)\n    slot[\u0027Qty\u0027] \u003d row.get(\u0027Qty\u0027)\nself.view.custom.StackRows \u003d stack\nqtbl.props.selection \u003d {\"rows\": []}"
                          },
                          "scope": "G",
                          "type": "script"
                        }
                      }
                    },
                    "meta": {
                      "name": "SendToStackBtn"
                    },
                    "props": {
                      "text": "Send to Stack"
                    },
                    "type": "ia.input.button"
                  },
                  {
                    "events": {
                      "component": {
                        "onActionPerformed": {
                          "config": {
                            "script": "q \u003d list(self.view.custom.Queue or []);\nnextId \u003d max([i.get(\u0027QueueItemID\u0027,0) for i in q] + [100]) + 1;\nq.append({\"QueueItemID\": nextId, \"Part\": \"P-%d\" % nextId, \"WorkOrder\": \"WO-%d\" % nextId, \"Qty\": 1, \"Priority\": 3});\nself.view.custom.Queue \u003d q"
                          },
                          "scope": "G",
                          "type": "script"
                        }
                      }
                    },
                    "meta": {
                      "name": "AddToQueueBtn"
                    },
                    "props": {
                      "text": "Add to Queue (demo)"
                    },
                    "type": "ia.input.button"
                  }
