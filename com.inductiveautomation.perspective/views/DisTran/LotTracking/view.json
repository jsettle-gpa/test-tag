                    "events": {
                      "component": {
                        "onActionPerformed": {
                          "config": {
                            "script": "rows \u003d list(self.view.custom.StackRows or [])\nfor r in rows:\n    r[\u0027QueueItemID\u0027] \u003d None\nself.view.custom.StackRows \u003d rows"
                          },
                          "scope": "G",
                          "type": "script"
                        }
                      }
                    },
                    "meta": {
                      "name": "ClearBtn"
