                "propConfig": {
                  "props.instances": {
                    "binding": {
                      "config": {
                        "path": "view.custom.Lots"
                      },
                      "transforms": [
                        {
                          "code": "\tinstances \u003d []\n\tfor lot in (value or []):\n\t    instances.append({\n\t        \"position\": \"absolute\",\n\t        \"top\":  \"%dpx\" % int(lot.get(\"Y\",0)),\n\t        \"left\": \"%dpx\" % int(lot.get(\"X\",0)),\n\t        \"width\":\"%dpx\" % int(lot.get(\"W\",200)),\n\t        \"height\":\"%dpx\" % int(lot.get(\"H\",120)),\n\t        \"zIndex\": int(lot.get(\"Z\", 1)),   # ← use Z here\n\t        \"viewPath\": \"App/Yard/LotTileSimple\",\n\t        \"viewParams\": {\n\t            \"LotID\": lot.get(\"LotID\"),\n\t            \"Name\": lot.get(\"Name\"),\n\t            \"Capacity\": lot.get(\"Capacity\"),\n\t            \"Occupancy\": lot.get(\"Occupancy\"),\n\t            \"Color\": lot.get(\"Color\")\n\t        },\n\t        \"style\": {\"classes\": \"\"}\n\t    })\n\treturn instances",
                          "type": "script"
                        }
                      ],
                      "type": "property"
                    }
                  }
                },
                "props": {
                  "style": {
                    "backgroundColor": "#11171a",
                    "height": "100%"
                  },
                  "transitionSettings": {
                    "duration": "200ms",
                    "timingFunction": "ease-in-out"
                  },
                  "useDefaultViewHeight": false,
                  "useDefaultViewWidth": false
                },
                "type": "ia.display.viewcanvas"
              }
            ],
            "meta": {
              "name": "MapCard"
            },
            "position": {
              "basis": "45%",
              "grow": 1
            },
            "props": {
              "direction": "column",
              "style": {
                "classes": "JeradCard Global/PaddingAll"
              }
            },
            "type": "ia.container.flex"
          },
          {
            "children": [
              {
                "meta": {
                  "name": "StackHdr"
                },
                "props": {
                  "style": {
                    "classes": "h3"
                  },
                  "text": "Top of Stack → Bottom"
                },
                "type": "ia.display.label"
              },
              {
                "meta": {
                  "name": "StackTable"
                },
                "position": {
                  "basis": "fill",
                  "grow": 1
                },
                "propConfig": {
                  "props.columns[1].editor.options": {
                    "binding": {
                      "config": {
                        "path": "view.custom.QueueOptions"
                      },
                      "type": "property"
                    }
                  },
                  "props.data": {
                    "binding": {
                      "config": {
                        "path": "view.custom.StackRows"
                      },
                      "type": "property"
                    }
                  }
                },
                "props": {
                  "columns": [
                    {
                      "editable": false,
                      "field": "Slot",
                      "header": {
                        "title": "Slot"
                      }
                    },
                    {
                      "editable": true,
                      "editor": {
                        "allowNull": true
                      },
                      "field": "QueueItemID",
                      "header": {
                        "title": "Select..."
                      },
                      "render": "dropdown"
                    }
                  ],
                  "selection": {
                    "enabled": false
                  },
                  "style": {
                    "height": "100%"
                  }
                },
                "type": "ia.display.table"
              },
              {
                "children": [
                  {
                    "events": {
                      "component": {
                        "onActionPerformed": {
                          "config": {
                            "script": "rows \u003d list(self.getSibling(\u0027StackTable\u0027).props.data or [])\nqueue \u003d list(self.view.custom.Queue or [])\nlotId \u003d self.view.custom.SelectedLocationID\nchosen \u003d [r.get(\u0027QueueItemID\u0027) for r in rows if r.get(\u0027QueueItemID\u0027)]\nnew_queue \u003d [q for q in queue if q.get(\u0027QueueItemID\u0027) not in chosen]\nfor r in rows:\n    qid \u003d r.get(\u0027QueueItemID\u0027)\n    if qid:\n        qmatch \u003d next((q for q in queue if q.get(\u0027QueueItemID\u0027)\u003d\u003dqid), None)\n        if qmatch:\n            r[\u0027Part\u0027] \u003d qmatch.get(\u0027Part\u0027); r[\u0027Qty\u0027] \u003d qmatch.get(\u0027Qty\u0027)\nself.view.custom.Queue \u003d new_queue\nself.view.custom.StackRows \u003d rows\nsystem.perspective.print(\u0027Placed %d item(s) into Location %s\u0027 % (len(chosen), lotId))"
                          },
                          "scope": "G",
                          "type": "script"
                        }
                      }
                    },
                    "meta": {
                      "name": "PlaceBtn"
                    },
                    "props": {
                      "text": "Place in Selected Location"
                    },
                    "type": "ia.input.button"
                  },
