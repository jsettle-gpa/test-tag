  "propConfig": {
    "custom.QueueOptions": {
      "binding": {
        "config": {
          "path": "view.custom.Queue"
        },
        "transforms": [
          {
            "code": "\topts \u003d []\n\tfor q in (value or []):\n\t    lbl \u003d \"%s (Qty %s) - %s\" % (q.get(\u0027Part\u0027,\u0027\u0027), q.get(\u0027Qty\u0027,\u0027\u0027), q.get(\u0027WorkOrder\u0027,\u0027\u0027))\n\t    opts.append({\"value\": q.get(\"QueueItemID\"), \"label\": lbl})\n\treturn opts",
            "type": "script"
          }
        ],
        "type": "property"
      },
      "persistent": true
    }
  },
