    "scripts": {
      "customMethods": [],
      "extensionFunctions": null,
      "messageHandlers": [
        {
          "messageType": "importProductCodes",
          "pageScope": true,
          "script": "\tlogger \u003d system.util.getLogger(\u0027import_productcodes\u0027)\n\t\n\ttry:\n\t    csvString \u003d payload.get(\"csvString\")\n\t    csvDict \u003d payload.get(\"csvDS\")\n\t    pyData \u003d system.dataset.toPyDataSet(csvDict)\n\t    queryPath \u003d \"app/Schedule/addProductCode\"\n\t\n\t    for row in pyData:\n\t        params \u003d {\n\t            \"productCode\": row[\"ProductCode\"],\n\t            \"description\": row[\"Description\"],\n\t            \"enabled\": row[\"IsEnabled\"],\n\t            \"idealRunRate\": row[\"IdealRunRate\"],\n\t            \"rateUoM\": row[\"RateUnitOfMeasure\"],\n\t            \"perUnitCost\": row[\"PerUnitCost\"],\n\t            \"instructions\": row[\"Instructions\"]\n\t        }\n\t\n\t        system.db.runNamedQuery(queryPath, params)\n\t        system.perspective.sendMessage(\"addedPC\")\n\t        system.perspective.closePopup(\"ImportFile\")\n\t\n\texcept Exception as e:\n\t    errorParams \u003d {\n\t        \"ModalName\": \"ErrorModal\",\n\t        \"ErrorMessage\": str(e),\n\t    }\n\t\n\t    system.perspective.openPopup(\"ErrorModal\", \"GlobalComponents/Modals/ErrorModal\", errorParams)\n\t    logger.warn(\u0027There was an error: \u0027 + str(e))",
          "sessionScope": true,
          "viewScope": false
        }
      ]
    },
    "type": "ia.container.flex"
