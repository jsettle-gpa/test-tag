    "custom.viewData.completed": {
      "binding": {
        "config": {
          "path": "view.custom.viewData.workOrders"
        },
        "transforms": [
          {
            "code": "\tdef col(row, name, default\u003dNone):\n\t\t\ttry:\n\t\t\t\tv \u003d row[name]\n\t\t\t\treturn default if v is None else v\n\t\t\texcept:\n\t\t\t\treturn default\n\t\t\n\tif value is None:\n\t\treturn []\n\t\n\tpds \u003d system.dataset.toPyDataSet(value)\n\tinstances \u003d []\n\tlaneWanted \u003d \u0027Complete\u0027\n\tfor r in pds:\n\t\tif col(r,\u0027lane\u0027,\u0027\u0027) !\u003d laneWanted:\n\t\t\tcontinue\n\t\tinstances.append({\n\t\t\t\t\"workOrder\": {\n\t\t\t\t\t\"id\":\t\t\tint(col(r, \"jobPieceId\", 0)),\n\t\t\t\t\t\"no\":\t\t\tcol(r, \"pieceKey\", \"\"),\n\t\t\t\t\t\"pieceMark\":\tcol(r, \"pieceMark\", \"\"),\n\t\t\t\t\t\"status\":\t\tcol(r, \"lane\", \"Planned\"),\n\t\t\t\t\t\"percent\":\t\tfloat(col(r, \"routePct\", 0.0)),  # or qtyPct if you prefer\n\t\t\t\t\t\"dueDate\":\t\tcol(r, \"dueDate\", None)\n\t\t\t\t},\n\t\t\t\"instanceStyle\": {\n\t\t\t\t\"classes\": \"\",\n\t\t\t\t\"marginBottom\": \"2%\"\n\t\t\t},\n\t\t\t\"instancePosition\": {\n\t\t\t\t\"grow\": 1\n\t\t\t}\n\t\t})\n\t\n\treturn instances",
            "type": "script"
          }
        ],
        "type": "property"
      }
    },
    "custom.viewData.notStarted": {
      "binding": {
        "config": {
          "path": "view.custom.viewData.workOrders"
        },
        "transforms": [
          {
            "code": "\tdef col(row, name, default\u003dNone):\n\t\t\ttry:\n\t\t\t\tv \u003d row[name]\n\t\t\t\treturn default if v is None else v\n\t\t\texcept:\n\t\t\t\treturn default\n\t\t\n\tif value is None:\n\t\treturn []\n\t\n\tpds \u003d system.dataset.toPyDataSet(value)\n\tinstances \u003d []\n\tlaneWanted \u003d \u0027Planned\u0027\n\tfor r in pds:\n\t\tif col(r,\u0027lane\u0027,\u0027\u0027) !\u003d laneWanted:\n\t\t\tcontinue\n\t\tinstances.append({\n\t\t\t\t\"workOrder\": {\n\t\t\t\t\t\"id\":\t\t\tint(col(r, \"jobPieceId\", 0)),\n\t\t\t\t\t\"no\":\t\t\tcol(r, \"pieceKey\", \"\"),\n\t\t\t\t\t\"pieceMark\":\tcol(r, \"pieceMark\", \"\"),\n\t\t\t\t\t\"status\":\t\tcol(r, \"lane\", \"Planned\"),\n\t\t\t\t\t\"percent\":\t\tfloat(col(r, \"routePct\", 0.0)),  # or qtyPct if you prefer\n\t\t\t\t\t\"dueDate\":\t\tcol(r, \"dueDate\", None)\n\t\t\t\t},\n\t\t\t\"instanceStyle\": {\n\t\t\t\t\"classes\": \"\",\n\t\t\t\t\"marginBottom\": \"2%\"\n\t\t\t},\n\t\t\t\"instancePosition\": {\n\t\t\t\t\"grow\": 1\n\t\t\t}\n\t\t})\n\t\n\treturn instances",
            "type": "script"
          }
        ],
        "type": "property"
