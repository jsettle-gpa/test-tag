{
  "custom": {},
  "params": {},
  "propConfig": {
    "params.data": {
      "paramDirection": "input",
      "persistent": false
    }
  },
  "props": {
    "defaultSize": {
      "height": 103,
      "width": 658
    }
  },
  "root": {
    "children": [
      {
        "children": [
          {
            "meta": {
              "name": "LotsRow"
            },
            "position": {
              "basis": "43px",
              "grow": 1
            },
            "propConfig": {
              "props.text": {
                "binding": {
                  "config": {
                    "expression": "if(\r\n\tisNull({view.params.data.LotNumber}) || toString({view.params.data.LotNumber}) \u003d \u0027\u0027,\r\n\t\u0027Lot: —\u0027,\r\n\t\u0027Lot: \u0027 + toString({view.params.data.LotNumber})\r\n)\r\n"
                  },
                  "type": "expr"
                }
              }
            },
            "props": {
              "style": {
                "color": "rgba(230,238,247,0.75)"
              },
              "textStyle": {
                "fontWeight": "600"
              }
            },
            "type": "ia.display.label"
          },
          {
            "meta": {
              "name": "PriorityChip"
            },
            "position": {
              "basis": "33.4%"
            },
            "propConfig": {
              "props.style.backgroundColor": {
                "binding": {
                  "config": {
                    "expression": "if(\r\n\tisNull({view.params.data.Priority}) || toString({view.params.data.Priority}) \u003d \u0027\u0027,\r\n\t\u0027#E0E0E0\u0027,   // default when null/blank\r\n\tif({view.params.data.Priority} \u003c\u003d 1, \u0027#2ecc71\u0027,      // green\r\n\t\tif({view.params.data.Priority} \u003c\u003d 2, \u0027#f1c40f\u0027,  // yellow\r\n\t\t\tif({view.params.data.Priority} \u003c\u003d 3, \u0027#e67e22\u0027,  // orange\r\n\t\t\t\t\u0027#e74c3c\u0027                                   // red (4+)\r\n\t\t\t)\r\n\t\t)\r\n\t)\r\n)\r\n"
                  },
                  "type": "expr"
                }
              },
              "props.style.border": {
                "binding": {
                  "config": {
                    "expression": "\"1px solid \" + \r\n(\r\n\tif(\r\n\t\tisNull({view.params.data.Priority}) || toString({view.params.data.Priority}) \u003d \u0027\u0027,\r\n\t\t\u0027#BDBDBD\u0027,   // neutral gray border when null/blank\r\n\t\tif({view.params.data.Priority} \u003c\u003d 1, \u0027#2ECC71\u0027,\r\n\t\t\tif({view.params.data.Priority} \u003c\u003d 2, \u0027#F1C40F\u0027,\r\n\t\t\t\tif({view.params.data.Priority} \u003c\u003d 3, \u0027#E67E22\u0027, \u0027#E74C3C\u0027)\r\n\t\t\t)\r\n\t\t)\r\n\t)\r\n)\r\n"
                  },
                  "type": "expr"
                }
              },
              "props.style.color": {
                "binding": {
                  "config": {
                    "expression": "if(\r\n\tisNull({view.params.data.Priority}) || toString({view.params.data.Priority}) \u003d \u0027\u0027,\r\n\t\u0027#111111\u0027,    // default when null/blank\r\n\tif({view.params.data.Priority} \u003e\u003d 3, \u0027white\u0027, \u0027black\u0027)\r\n)\r\n"
                  },
                  "type": "expr"
                }
              },
              "props.text": {
                "binding": {
                  "config": {
                    "path": "view.params.data.Priority"
                  },
                  "transforms": [
                    {
                      "expression": "if(\r\n\tisNull({value}) || toString({value}) \u003d \u0027\u0027,\r\n\t\u0027Priority Unknown\u0027,\r\n\t\u0027Priority: \u0027 + toString({value})\r\n)\r\n",
                      "type": "expression"
                    }
                  ],
                  "type": "property"
                }
              }
            },
            "props": {
              "style": {
                "borderRadius": "999px",
                "padding": "4px 14px"
              },
              "textStyle": {
                "fontWeight": "600",
                "textAlign": "center"
              }
            },
            "type": "ia.display.label"
          }
        ],
        "meta": {
          "name": "HeaderRow"
        },
        "position": {
          "basis": "37px"
        },
        "props": {
          "alignItems": "center",
          "justify": "space-between",
          "style": {
            "overflow": "visible"
          }
        },
        "type": "ia.container.flex"
      },
      {
        "meta": {
          "name": "Divider"
        },
        "position": {
          "basis": "32px"
        },
        "props": {
          "style": {
            "backgroundColor": "rgba(255,255,255,0.06)",
            "height": "1px",
            "marginBottom": "6px",
            "marginTop": "6px"
          }
        },
        "type": "ia.container.flex"
      },
      {
        "events": {
          "dom": {
            "onClick": {
              "config": {
                "script": "\tdata\t\u003d self.view.params.data\n\turl\t\t\u003d data.get(\u0027ProgramURL\u0027) or data.get(\u0027DxfUrl\u0027) or \"https://globalprocessautomation.sharepoint.com/:b:/g/PMO/DIS-TRAN%20Steel/Eb3pMVlyYzhEkdPG91QvNogBMbBROPV_w-nmBY7XE8po1A?e\u003dy9JwLw\"\n\tsystem.perspective.navigate(url\u003durl, newTab\u003dTrue)"
              },
              "scope": "G",
              "type": "script"
            }
          }
        },
        "meta": {
          "name": "ProgramName"
        },
        "position": {
          "basis": "70%",
          "grow": 1
        },
        "propConfig": {
          "props.text": {
            "binding": {
              "config": {
                "path": "view.params.data.ProgramName"
              },
              "transforms": [
                {
                  "expression": "if(IsNull({value}),\u0027Program: \u0027,\u0027Program: \u0027 + {value})",
                  "type": "expression"
                }
              ],
              "type": "property"
            }
          }
        },
        "props": {
          "style": {
            "color": "#E6EEF7",
            "cursor": "pointer",
            "fontSize": "14px",
            "fontWeight": "700",
            "textDecoration": "underline"
          }
        },
        "type": "ia.display.label"
      }
    ],
    "meta": {
      "name": "root"
    },
    "props": {
      "direction": "column",
      "style": {
        "border": "1px solid rgba(255,255,255,0.06)",
        "borderRadius": "12px",
        "boxShadow": "inset 0 0 0 1px rgba(255,255,255,0.02), 0 4px 10px rgba(0,0,0,0.35)",
        "classes": "card",
        "gap": "10px",
        "padding": "14px 16px"
      }
    },
    "type": "ia.container.flex"
  }
}