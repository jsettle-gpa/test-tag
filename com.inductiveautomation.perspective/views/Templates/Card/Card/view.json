                  "style": {
                    "fontSize": "15px",
                    "fontWeight": "700"
                  },
                  "text": "Card Title"
                },
                "type": "ia.display.label"
              }
            ],
            "meta": {
              "name": "Header"
            },
            "props": {
              "alignItems": "center",
              "style": {
                "classes": "Cards/Common/CardTitleBorder",
                "gap": "8px"
              }
            },
            "type": "ia.container.flex"
          },
          {
            "children": [
              {
                "meta": {
                  "name": "ContentHint"
                },
                "props": {
                  "style": {
                    "opacity": 0.8
                  },
                  "text": "Place content here (tables, lists, forms, charts, etc.)"
                },
                "type": "ia.display.label"
              }
