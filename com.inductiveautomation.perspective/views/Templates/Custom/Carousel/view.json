{
  "custom": {
    "result": {},
    "wizard": {
      "currentPane": 0,
      "errors": {},
      "panes": [
        {
          "id": "step-1",
          "params": {
            "allowUpload": true
          },
          "requiredFields": [
            "dataSource",
            "fileName",
            "fileData"
          ],
          "subtitle": "Choose where your data comes from",
          "title": "Select Source",
          "validatorScript": "",
          "viewPath": "Common/Embedded/SelectDataSource"
        },
        {
          "id": "step-2",
          "params": {},
          "requiredFields": [
            "attributeSelection"
          ],
          "subtitle": "Map incoming columns to attributes",
          "title": "Map Fields",
          "validatorScript": "",
          "viewPath": "Common/Embedded/MapAttributes"
        },
        {
          "id": "step-3",
          "params": {},
          "requiredFields": [],
          "subtitle": "Verify before importing",
          "title": "Preview",
          "validatorScript": "",
          "viewPath": "Common/Embedded/Preview"
        }
      ],
      "values": {}
    }
  },
  "params": {
    "CloseOnFinish": true,
    "FinishMessageType": "wizard.finished",
    "PopupId": "GenericWizard",
    "Title": "Wizard"
  },
  "propConfig": {
    "custom.wizard": {
      "persistent": true
    },
    "custom.wizard.navState": {
      "binding": {
        "config": {
          "struct": {
            "currentPane": "{view.custom.wizard.currentPane}",
            "panes": "{view.custom.wizard.panes}",
            "values": "{view.custom.wizard.values}"
          },
          "waitOnAll": true
        },
        "transforms": [
          {
            "code": "\t# Compute navigation state from panes, current index, and collected values\n\ttry:\n\t\tpanes \u003d list(value.get(\u0027panes\u0027) or [])\n\texcept:\n\t\tpanes \u003d []\n\tidx \u003d int(value.get(\u0027currentPane\u0027) or 0)\n\tidx \u003d max(0, min(idx, len(panes)-1))\n\tvals \u003d dict(value.get(\u0027values\u0027) or {})\n\tisLast \u003d (len(panes) \u003e 0 and idx \u003d\u003d len(panes)-1)\n\tcanPrev \u003d (idx \u003e 0)\n\t# Validate current pane\n\tdef _hasRequired(p):\n\t\trequired \u003d list(p.get(\u0027requiredFields\u0027) or [])\n\t\tfor k in required:\n\t\t\tif k not in vals or vals.get(k) in (None, u\"\", [], {}):\n\t\t\t\treturn False\n\t\treturn True\n\tvalid \u003d False\n\tpane \u003d panes[idx] if panes else {}\n\t# Optional per-pane validator script (return True/False)\n\tvalidator \u003d pane.get(\u0027validatorScript\u0027) or \u0027\u0027\n\tif validator:\n\t\tctx \u003d {\u0027values\u0027: vals, \u0027pane\u0027: pane}\n\t\ttry:\n\t\t\tvalid \u003d bool(eval(validator, {}, ctx))\n\t\texcept:\n\t\t\tvalid \u003d False\n\telse:\n\t\tvalid \u003d _hasRequired(pane)\n\tcanNext \u003d (not isLast) and valid\n\tcanFinish \u003d isLast and valid\n\treturn {\n\t\t\u0027canPrev\u0027: canPrev,\n\t\t\u0027canNext\u0027: canNext,\n\t\t\u0027canFinish\u0027: canFinish,\n\t\t\u0027isLast\u0027: isLast\n\t}",
            "type": "script"
          }
        ],
        "type": "expr-struct"
      }
    },
    "params.CloseOnFinish": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.FinishMessageType": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.PopupId": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.Title": {
      "paramDirection": "input",
      "persistent": true
    }
  },
  "props": {
    "defaultSize": {
      "height": 560
    }
  },
  "root": {
    "children": [
      {
        "children": [
          {
            "children": [
