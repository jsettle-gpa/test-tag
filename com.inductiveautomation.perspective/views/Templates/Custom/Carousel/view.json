                      "panes": "{view.custom.wizard.panes}"
                    },
                    "waitOnAll": true
                  },
                  "transforms": [
                    {
                      "code": "\ttry:\n\t\tpanes \u003d list(value.get(\u0027panes\u0027) or [])\n\t\tidx \u003d int(value.get(\u0027idx\u0027) or 0)\n\t\treturn u\"Step %d of %d\" % (idx+1, len(panes))\n\texcept:\n\t\treturn \u0027\u0027",
                      "type": "script"
                    }
                  ],
                  "type": "expr-struct"
                }
              }
            },
            "props": {
              "style": {
                "fontSize": "12px",
                "opacity": 0.7,
                "textAlign": "right"
              }
            },
            "type": "ia.display.label"
          }
        ],
        "meta": {
          "name": "Header"
        },
        "position": {
          "basis": "64px",
          "shrink": 0
        },
        "props": {
          "alignItems": "center",
          "justify": "space-between",
          "style": {
            "borderBottom": "1px solid var(--neutral-300)"
          }
        },
        "type": "ia.container.flex"
      },
      {
        "children": [
          {
            "meta": {
              "name": "EmbeddedPane"
            },
            "position": {
              "basis": "100%",
              "grow": 1
            },
            "propConfig": {
              "props.params": {
                "binding": {
                  "config": {
                    "struct": {
                      "idx": "{view.custom.wizard.currentPane}",
                      "panes": "{view.custom.wizard.panes}",
                      "values": "{view.custom.wizard.values}"
                    },
                    "waitOnAll": true
                  },
                  "transforms": [
                    {
                      "code": "\t# Provide pane params + current values so child views can read what was chosen earlier\n\ttry:\n\t\tpanes \u003d list(value.get(\u0027panes\u0027) or [])\n\t\tidx \u003d int(value.get(\u0027idx\u0027) or 0)\n\t\tpane \u003d panes[idx]\n\t\tparams \u003d dict(pane.get(\u0027params\u0027) or {})\n\t\tparams.update({\u0027wizardValues\u0027: dict(value.get(\u0027values\u0027) or {})})\n\t\treturn params\n\texcept:\n\t\treturn {}",
                      "type": "script"
                    }
                  ],
                  "type": "expr-struct"
                }
              },
              "props.path": {
                "binding": {
                  "config": {
                    "struct": {
                      "idx": "{view.custom.wizard.currentPane}",
                      "panes": "{view.custom.wizard.panes}"
                    },
                    "waitOnAll": true
                  },
                  "transforms": [
                    {
                      "code": "\ttry:\n\t\tpanes \u003d list(value.get(\u0027panes\u0027) or [])\n\t\tidx \u003d int(value.get(\u0027idx\u0027) or 0)\n\t\treturn panes[idx].get(\u0027viewPath\u0027) or \u0027\u0027\n\texcept:\n\t\treturn \u0027\u0027",
                      "type": "script"
                    }
                  ],
                  "type": "expr-struct"
                }
              }
            },
            "props": {
              "style": {
                "height": "100%"
              }
            },
            "type": "ia.display.view"
          }
        ],
        "meta": {
          "name": "Content"
        },
        "position": {
          "grow": 1
        },
        "props": {
          "style": {
            "overflow": "hidden",
            "paddingBottom": "8px",
            "paddingTop": "8px"
          }
        },
        "type": "ia.container.flex"
      },
      {
        "children": [
          {
            "children": [
              {
                "events": {
                  "dom": {
                    "onClick": {
                      "config": {
                        "script": "self.view.custom.wizard.currentPane \u003d max(0, self.view.custom.wizard.currentPane - 1)"
                      },
                      "scope": "G",
                      "type": "script"
                    }
                  }
                },
                "meta": {
                  "name": "BackButton"
                },
                "position": {
                  "basis": "10%",
                  "grow": 1,
                  "shrink": 0
                },
                "propConfig": {
                  "props.enabled": {
                    "binding": {
                      "config": {
