        "gap": "12px",
        "padding": "16px"
      }
    },
    "scripts": {
      "customMethods": [
        {
          "name": "finish",
          "params": [],
          "script": "\t\t# Validate we can finish\n\tns \u003d dict(self.view.custom.wizard.navState or {})\n\tif not ns.get(\u0027canFinish\u0027, False):\n\t    return  # Current pane isn\u0027t valid to finish yet\n\t\n\t# Gather details\n\tvals \u003d dict(self.view.custom.wizard.values or {})\n\tpanes \u003d list(self.view.custom.wizard.panes or [])\n\tidx \u003d int(self.view.custom.wizard.currentPane or 0)\n\tidx \u003d max(0, min(idx, max(0, len(panes) - 1)))\n\tcurPane \u003d panes[idx] if panes else {}\n\t\n\tpayload \u003d {\n\t    \u0027wizardValues\u0027: vals,\n\t    \u0027paneCount\u0027: len(panes),\n\t    \u0027currentPaneIndex\u0027: idx,\n\t    \u0027currentPaneId\u0027: curPane.get(\u0027id\u0027),\n\t    \u0027currentPaneTitle\u0027: curPane.get(\u0027title\u0027),\n\t    \u0027timestamp\u0027: system.date.now()\n\t}\n\t\n\t# Send completion message\n\tmsgType \u003d self.view.params.FinishMessageType or \u0027wizard.finished\u0027\n\tsystem.perspective.sendMessage(messageType\u003dmsgType, payload\u003dpayload, scope\u003d\u0027page\u0027)\n\t\n\t# Optionally close the popup\n\tif bool(self.view.params.CloseOnFinish):\n\t    popupId \u003d self.view.params.PopupId or \u0027GenericWizard\u0027\n\t    try:\n\t        system.perspective.closePopup(popupId)\n\t    except:\n\t        pass  # Ignore if already closed or ID not found"
        }
      ],
      "extensionFunctions": null,
      "messageHandlers": [
        {
          "messageType": "wizard.update",
          "pageScope": true,
          "script": "\n\t# Update one or more keys in the wizard values\n\tvals \u003d self.view.custom.wizard.values\n\tif vals is None:\n\t\tvals \u003d {}\n\t\tself.view.custom.wizard.values \u003d vals\n\t# Allow payload like {key:\u0027fileName\u0027, value:\u0027foo.csv\u0027} or {updates:{k:v}}\n\tkey \u003d payload.get(\u0027key\u0027)\n\tif key is not None:\n\t\tvals[key] \u003d payload.get(\u0027value\u0027)\n\tupdates \u003d payload.get(\u0027updates\u0027) or {}\n\tif isinstance(updates, dict):\n\t\tfor k,v in updates.items():\n\t\t\tvals[k] \u003d v\n",
          "sessionScope": false,
          "viewScope": false
        },
        {
          "messageType": "wizard.go",
          "pageScope": true,
          "script": "\t\n\t# Navigate wizard panes via messages\n\tact \u003d (payload.get(\u0027action\u0027) or \u0027\u0027).lower()\n\tidx \u003d int(self.view.custom.wizard.currentPane)\n\tcount \u003d len(self.view.custom.wizard.panes or [])\n\tif act \u003d\u003d \u0027next\u0027 and idx \u003c max(0, count-1):\n\t\tself.view.custom.wizard.currentPane \u003d idx + 1\n\telif act \u003d\u003d \u0027prev\u0027 and idx \u003e 0:\n\t\tself.view.custom.wizard.currentPane \u003d idx - 1\n\telif act \u003d\u003d \u0027set\u0027:\n\t\ttarget \u003d int(payload.get(\u0027index\u0027) or 0)\n\t\tself.view.custom.wizard.currentPane \u003d max(0, min(target, max(0, count-1)))\n",
          "sessionScope": false,
          "viewScope": false
        },
        {
          "messageType": "wizard.finish",
          "pageScope": true,
          "script": "\t\n\t# External trigger to finish\n\tself.finish()\n",
          "sessionScope": false,
          "viewScope": false
        }
      ]
    },
    "type": "ia.container.flex"
  }
}