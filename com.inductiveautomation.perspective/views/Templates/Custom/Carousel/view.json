                          "type": "script"
                        }
                      ],
                      "type": "expr-struct"
                    }
                  }
                },
                "props": {
                  "style": {
                    "fontSize": "12px",
                    "opacity": 0.8
                  }
                },
                "type": "ia.display.label"
              }
            ],
