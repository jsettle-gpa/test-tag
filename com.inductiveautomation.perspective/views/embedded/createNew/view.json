              {
                "events": {
                  "component": {
                    "onActionPerformed": {
                      "config": {
                        "script": "\tpageOrder \u003d [\n\t\t\"eqConfig\",\n\t\t\"lineConfig\",\n\t\t\"cellConfig\",\n\t\t\"modeGroup\",\n\t\t\"stateGroup\",\n\t\t\"edgeConfig\",\n\t\t\"derivedConfig\"\n\t]\n\tenabledPages \u003d [\"eqConfig\"] + [\n\t\tpage for page in pageOrder[1:] if self.view.custom.pages.get(page, False)\n\t]\n\tcurrent \u003d self.view.custom.activePage\n\tidx \u003d enabledPages.index(current) if current in enabledPages else 0\n\tif idx \u003c len(enabledPages) - 1:\n\t\tself.view.custom.activePage \u003d enabledPages[idx + 1]"
                      },
                      "scope": "G",
                      "type": "script"
                    }
                  }
                },
                "meta": {
                  "name": "nextBtn"
                },
                "position": {
                  "basis": "80px",
                  "grow": 1
                },
                "propConfig": {
                  "position.display": {
                    "binding": {
                      "config": {
                        "expression": "{view.custom.activePage} !\u003d \r\n    if({view.custom.pages.derivedConfig}, \"derivedConfig\",\r\n      if({view.custom.pages.edgeConfig}, \"edgeConfig\",\r\n        if({view.custom.pages.stateGroup}, \"stateGroup\",\r\n          if({view.custom.pages.modeGroup}, \"modeGroup\",\r\n            if({view.custom.pages.cellConfig}, \"cellConfig\",\r\n              if({view.custom.pages.lineConfig}, \"lineConfig\",\r\n                \"eqConfig\"\r\n              )\r\n            )\r\n          )\r\n        )\r\n      )\r\n    )\r\n"
                      },
                      "type": "expr"
                    }
                  }
                },
